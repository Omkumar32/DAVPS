// Prisma Schema for Dayanand Arya Vidya Public School (PostgreSQL - Supabase)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Faculty {
  id            String   @id @default(cuid())
  serialNo      Int
  name          String
  designation   String
  qualification String
  category      String   @default("TGT")
  image         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsEvent {
  id          String   @id @default(cuid())
  title       String
  date        String
  category    String
  excerpt     String   @db.Text
  fullContent String   @db.Text
  image       String   @db.Text
  author      String   @default("Admin")
  readTime    String   @default("3 min read")
  createdAt   DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  image     String   @db.Text
  caption   String   @db.Text
  date      String
  createdAt DateTime @default(now())
}

model AdmissionEnquiry {
  id          String   @id @default(cuid())
  studentName String
  parentName  String
  phone       String
  email       String
  grade       String
  address     String?  @db.Text
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  date        String
  category    String
  description String?  @db.Text
  pdfUrl      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id           String   @id @default(cuid())
  title        String
  studentName  String
  category     String
  achievement  String   @db.Text
  scoreOrMedal String
  year         String
  image        String?  @db.Text
  quote        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Program {
  id          String   @id @default(cuid())
  title       String
  grades      String
  ageGroup    String
  description String   @db.Text
  features    String?  @db.Text
  image       String   @db.Text
  iconName    String?  @default("BookOpen")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
